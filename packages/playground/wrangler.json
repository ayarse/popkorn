{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "popkorn-playground",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server/entry.ts",
  "routes": [{ "pattern": "usepopkorn.dev", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "popkorn",
      "database_id": "4ce7f037-ebe3-4b5e-a61f-761a2f3146e7",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "COPILOT_SESSION", "class_name": "CopilotSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CopilotSession"] }],
  "observability": { "enabled": true }
}
