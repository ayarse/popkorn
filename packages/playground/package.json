{
  "name": "@popkorn/playground",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc -b",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply popkorn --remote",
    "db:migrate:local": "wrangler d1 migrations apply popkorn --local",
    "db:console": "wrangler d1 execute popkorn --remote --command",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.4.25",
    "@clerk/themes": "^2.4.57",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@popkorn/converters": "workspace:*",
    "@popkorn/parser": "workspace:*",
    "@popkorn/player": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-start": "^1.168.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "driver.js": "^1.6.0",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "mp4-muxer": "^5.2.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-simple-code-editor": "^0.14.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.49.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^7.1.14",
    "wrangler": "^4.116.0"
  }
}
